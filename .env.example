# Copy to .env. Never commit .env.

# "mock" runs everything offline from recorded fixtures (no keys needed). "gemini" calls the real APIs.
PROVIDER=mock

# "auto" follows PROVIDER; "youtube" uses real YouTube previews even with PROVIDER=mock.
VIDEO_LOOKUP=auto

# Required only when PROVIDER=gemini.
GEMINI_API_KEY=
YOUTUBE_DATA_API_KEY=
# Model IDs from https://ai.google.dev/gemini-api/docs/models (checked Nov 2026).
# Suggested: standard gemini-3.8-flash, deep gemini-4-carbon (no model is named "Pro" now),
# fallbacks gemini-3.6-flash,gemini-3.5-flash-lite (comma-separated, tried in order).
GEMINI_MODEL_STANDARD=
GEMINI_MODEL_DEEP=
GEMINI_MODEL_FALLBACK=

DATABASE_URL=postgres://matchcut:matchcut@localhost:5432/matchcut
REDIS_URL=redis://localhost:6379

# Stands in for a Cardboard session. Any non-empty string for local dev.
DEV_API_TOKEN=dev-token-change-me

DAILY_SPEND_CAP_USD=5

# Ports and URLs for local dev.
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Browser origin the API allows (CORS).
WEB_ORIGIN=http://localhost:3000

# Region the server serves from, for region-blocked videos.
YOUTUBE_REGION=US

# PRD caps: 20-minute videos without a clip range, 10-minute clip ranges.
MAX_VIDEO_SECONDS=1200
MAX_CLIP_SECONDS=600

# Goal text is encrypted at rest. Required in production. Generate with: openssl rand -base64 32
GOAL_ENCRYPTION_KEY=
# After rotating, put the old key(s) here (comma-separated) so existing goals stay readable.
GOAL_ENCRYPTION_KEY_PREVIOUS=

# Gemini retries (PRD: 1 s then 3 s, one retry on the same model before falling back).
GEMINI_RETRY_BACKOFF_MS=1000,3000
GEMINI_RETRY_SAME_MODEL=1

# Job budget and limits (PRD defaults).
JOB_MAX_FAILED_ATTEMPTS=4
JOB_TIMEOUT_SECONDS=240
QUEUE_MAX_WAIT_SECONDS=120
WORKER_CONCURRENCY=8
RATE_USER_PER_HOUR=20
RATE_USER_PER_DAY=100
RATE_REGENERATE_PER_HOUR=60
RATE_ORG_PER_DAY=1000
BRIEF_RETENTION_DAYS=90

# Match Cut MCP server at /mcp on the API (Claude and ChatGPT connectors). Comma-separated API keys,
# 24+ characters each; each key is its own user. Leave empty to turn the MCP server off.
# Generate one with: openssl rand -hex 24
MCP_API_KEYS=

# Web app (Vercel) only: where the /api/mc proxy sends requests, and the API token to add.
# Leave unset locally; the proxy then reads API_PORT and DEV_API_TOKEN from this file.
# MATCH_CUT_API_URL=https://your-api.example.com
# MATCH_CUT_API_TOKEN=
